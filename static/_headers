# Cloudflare Pages headers (ignored by GitHub Pages, harmless there).
# Hugo Pipes output is content-fingerprinted -> safe to cache immutably.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
# Processed images carry a _hu_ content hash; static ones (logo, og-image) change rarely -> 1 week.
/images/*
  Cache-Control: public, max-age=604800
/audio/*
  Cache-Control: public, max-age=604800
